# ── Backend (never exposed to the browser) ───────────────────────────
# SQLite file, relative to database/prisma/schema.prisma → database/dev.db
DATABASE_URL="file:../dev.db"
PORT=4000
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:5173
# Requests per IP per minute on /api
RATE_LIMIT_PER_MINUTE=120

# ── Frontend (only VITE_* variables reach the browser bundle) ────────
# Leave as /api in development: Vite proxies it to the backend.
VITE_API_BASE_URL=/api
